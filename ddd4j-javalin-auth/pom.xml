<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-dependencies</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-auth</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-javalin 认证授权整合聚合：auth-core（共享 Module 骨架）+ license / satoken / security / shiro
        与 Javalin + Guice 深度整合。
        底层复用 io.ddd4j:ddd4j-auth-* 纯 Java 实现，本层提供 Guice Module、Javalin ExceptionHandler。
    </description>

    <modules>
        <module>ddd4j-javalin-auth-core</module>
        <module>ddd4j-javalin-auth-license</module>
        <module>ddd4j-javalin-auth-satoken</module>
        <!-- 1.0.x 改挂排除：上游 ddd4j-auth-security:1.0.x 的 SecuritySubject/SecuritySubjectProvider
             编译期引用 1.0.x core 中已不存在的整套 2.0.x 鉴权门面（io.ddd4j.core.auth.AuthRequest/
             AuthPrincipal、io.ddd4j.core.util.SubjectKit、SubjectDataProvider/SubjectStrategy 与
             AccountExpiredException 等 7 个异常类），类链接即 NoClassDefFoundError；补齐需内联
             13+ 个类且与 1.0.x core.subject.SubjectKit 语义割裂，待上游对齐后恢复。
             对应 sample-auth-security 同步排除。 -->
        <!-- <module>ddd4j-javalin-auth-security</module> -->
        <module>ddd4j-javalin-auth-shiro</module>
    </modules>

</project>

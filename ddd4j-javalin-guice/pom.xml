<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-guice</artifactId>
    <description>
        ddd4j-javalin 的 Guice 兼容层：保留历史扫描模块入口，实际复用 ddd4j-guice 的通用扫描和核心 SPI 实现。
    </description>

    <dependencies>
        <!-- ======== Guice IoC 容器 ======== -->
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>

        <!-- ======== ddd4j-guice：复用核心 SPI 的 Guice 实现（Ddd4jGuiceModule）======== -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-guice</artifactId>
        </dependency>

    </dependencies>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-data-jpa</artifactId>
    <description>
        ddd4j-javalin 数据层 - JPA/Hibernate 实现：
        基于 jakarta.persistence API，适配 ddd4j-core 的 Repository/TypeHandlerRegistry SPI，
        提供 Javalin + Guice 桥接的 AggregateRepository + JPA EntityManager 抽象。
    </description>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- ddd4j-data-jpa：标准 JPA 仓储基类（JpaAggregateRepository + 加密监听器） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-jpa</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- 1.0.x 改挂补钉：jakarta.persistence-api 版本 1.0.x 链不管理，显式钉 3.1.0 -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>3.1.0</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-web</artifactId>
            <version>${revision}</version>
        </dependency>
            <!-- 1.0.x 改挂补钉：assertj 原经 2.0.x 上游链传递，1.0.x 链不传递，显式声明（版本由 1.0.x ddd4j-dependencies 管理） -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

</project>

<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-parent</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-samples</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <!-- Auth 鉴权示例：演示 SubjectKit 统一鉴权入口（Javalin 编程式路由 + Guice）。
             原有的 sample-druid（io.javalin.sample 独立体系 + 不完整 JOOQ 生成代码 +
             引用已铲除的平行宇宙包）已移除，避免维护与 ddd4j 适配无关的腐烂示例。 -->
        <module>ddd4j-javalin-sample-auth-satoken</module>
        <!-- 1.0.x 改挂排除：上游 1.0.x ddd4j-auth-security / ddd4j-auth-shiro 构件残留对
             io.ddd4j.core.auth.*（AuthRequest/AuthPrincipal 2.0.x 包名）的编译期引用，
             而该包在 1.0.x ddd4j-core 中已不存在（SecuritySubject/ShiroSubject 类链接不安全），
             示例的 SubjectKit 门面（login/logout）在 1.0.x 亦无等价实现，待上游对齐后恢复。 -->
        <!-- <module>ddd4j-javalin-sample-auth-security</module> -->
        <!-- <module>ddd4j-javalin-sample-auth-shiro</module> -->
        <!-- <module>ddd4j-javalin-sample-cqrs-person</module> 上游构件缺失（与 7.1.x 同步排除） -->
        <!-- <module>ddd4j-javalin-sample-rich-model</module> 上游构件缺失（与 7.1.x 同步排除） -->
        <module>ddd4j-javalin-sample-mybatis-testcontainers</module>
        <module>ddd4j-javalin-sample-order-outbox</module>
    </modules>

</project>

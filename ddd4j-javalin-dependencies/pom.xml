<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-javalin-dependencies</artifactId>
    <packaging>pom</packaging>
    <description>
        Javalin 依赖 BOM：import io.ddd4j:ddd4j-dependencies（第三方 + Spring Framework），
        仅追加 Javalin 专属版本；Maven 插件版本继承 ddd4j-parent，仅补充 Javalin 构建所需插件。
    </description>

    <properties>
        <!-- Javalin 6.7.0 是本发布线唯一的 HTTP 框架运行版本。 -->
        <javalin.version>6.7.0</javalin.version>

        <!-- Jetty 11.0.25（Javalin 6.7.0 基线）。
             注意属性名不能叫 jetty.version：Maven 的 import BOM 中 ${jetty11.version} 按消费者
             属性插值，若同名会把父 BOM 的 jetty-bom/ee10-bom import 一并带成 11.0.25
             （jetty-ee10-bom 无 11.x 版本，直接解析失败）。父 BOM 维持 12.1.12 import 不受影响。 -->
        <jetty11.version>11.0.25</jetty11.version>
        <jackson.version>2.17.2</jackson.version>
        <jackson-databind.version>2.17.2</jackson-databind.version>

        <!-- Javalin 专属：legacy javax.servlet（ddd4j-dependencies 仅 pin jakarta.servlet） -->
        <javax.servlet-api.version>4.0.1</javax.servlet-api.version>

        <!-- Javalin 专属：legacy Swagger 1.x 注解（javalin-api 使用 io.swagger.annotations） -->
        <swagger.version>1.6.14</swagger.version>

        <!-- Javalin 专属：API 文档离线生成（ddd4j-javalin-parent 引用） -->
        <asciidoctorj.version>3.0.0</asciidoctorj.version>
        <asciidoctorj.pdf.version>2.3.18</asciidoctorj.pdf.version>

        <!-- Javalin 专属：Spotify Docker 插件（与 ddd4j 的 io.fabric8 docker-maven-plugin 并存） -->
        <maven-spotify-docker-plugin.version>1.2.0</maven-spotify-docker-plugin.version>
        <maven-dockerfile-plugin.version>1.4.13</maven-dockerfile-plugin.version>
        <maven-swagger2markup-plugin.version>1.3.7</maven-swagger2markup-plugin.version>

        <!-- Testcontainers 集成测试镜像版本（对齐 ddd4j-boot mq/README.md §13） -->
        <testcontainers.version>1.20.6</testcontainers.version>
        <testcontainers-keycloak.version>3.7.0</testcontainers-keycloak.version>
        <wiremock-standalone.version>3.9.1</wiremock-standalone.version>

        <!-- ddd4j 1.0.x 未管理、但本适配层测试与 Panache 模块直接消费的版本。 -->
        <awaitility.version>4.2.2</awaitility.version>
        <quarkus-bom.version>3.37.0</quarkus-bom.version>
        <artemis-json-api.version>1.1.6</artemis-json-api.version>
        <commons-lang3-testcontainers.version>3.18.0</commons-lang3-testcontainers.version>
        <!-- ddd4j 1.0.x consumer BOM only manages the JDK 8 -4.9 parser variant. -->
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <jaxb-runtime.version>4.0.6</jaxb-runtime.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.glassfish.jaxb</groupId>
                <artifactId>jaxb-runtime</artifactId>
                <version>${jaxb-runtime.version}</version>
            </dependency>
            <!-- 与 ddd4j-dependencies import 对齐：第三方库 + Spring Framework 6.x -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-dependencies</artifactId>
                <version>${ddd4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jetty 11.0.25 显式覆盖（Javalin 6.7.0 基线）— 父 ddd4j-dependencies BOM 的 jetty-bom:12.1.12
                 与 Javalin 6.7.0 传递的 Jetty 11.x 冲突；此处逐个覆盖核心 Jetty artifact 为 11.0.25。 -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-server</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-http</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-io</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-util</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-security</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-servlet</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-webapp</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-xml</artifactId>
                <version>${jetty11.version}</version>
            </dependency>
            <!-- 核心 BOM 把 websocket-servlet 提升到 12.1.8（不存在，Jetty 12.1.x 中
                 websocket-servlet 已迁移到 ee10 命名空间）。6.7.x 用 Jetty 11，
                 显式降回 11.0.25 与传递依赖 websocket-jetty-server 对齐。 -->
            <dependency>
                <groupId>org.eclipse.jetty.websocket</groupId>
                <artifactId>websocket-servlet</artifactId>
                <version>${jetty11.version}</version>
            </dependency>

            <!-- ddd4j Guice 适配（提供 3 个核心 SPI 的 Guice 实现 Ddd4jGuiceModule） -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-runtime-guice</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>

            <!-- ddd4j web 适配（Javalin 6）— 双轨模块，applyTo 契约 -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-web-javalin</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>

            <dependency>
                <groupId>org.awaitility</groupId>
                <artifactId>awaitility</artifactId>
                <version>${awaitility.version}</version>
            </dependency>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus-bom.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Javalin is built on JDK 17 and consumes the standard parser artifact. -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>

            <!-- Javalin 6.7.0 核心框架与 OpenAPI 插件（显式覆盖父 BOM javalin-bom:7.2.2 管理的版本） -->
            <dependency>
                <groupId>io.javalin</groupId>
                <artifactId>javalin</artifactId>
                <version>${javalin.version}</version>
            </dependency>
            <dependency>
                <groupId>io.javalin.community.openapi</groupId>
                <artifactId>javalin-openapi-plugin</artifactId>
                <version>${javalin.version}</version>
            </dependency>
            <dependency>
                <groupId>io.javalin.community.openapi</groupId>
                <artifactId>javalin-swagger-plugin</artifactId>
                <version>${javalin.version}</version>
            </dependency>
            <dependency>
                <groupId>io.javalin.community.openapi</groupId>
                <artifactId>javalin-redoc-plugin</artifactId>
                <version>${javalin.version}</version>
            </dependency>

            <!-- Javalin 专属：legacy javax.servlet（扩展模块 optional 依赖） -->
            <dependency>
                <groupId>javax.servlet</groupId>
                <artifactId>javax.servlet-api</artifactId>
                <version>${javax.servlet-api.version}</version>
            </dependency>

            <!-- Testcontainers BOM（对齐 ddd4j-boot mq/README.md §13 的 1.20.6） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- ddd4j 1.0.x 先管理了 Testcontainers 1.17.3；直接声明确保本项目统一覆盖为 1.20.6。 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>jdbc</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>database-commons</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3-testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mysql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>postgresql</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mariadb</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>mongodb</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>kafka</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>rabbitmq</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>localstack</artifactId>
                <version>${testcontainers.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.dasniko</groupId>
                <artifactId>testcontainers-keycloak</artifactId>
                <version>${testcontainers-keycloak.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock-standalone.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ddd4j 1.0.x 管理 AssertJ 版本但不再通过父链传递测试依赖。 -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Javalin 专属：API 文档离线生成（ddd4j-parent 未收录） -->
                <plugin>
                    <groupId>org.asciidoctor</groupId>
                    <artifactId>asciidoctor-maven-plugin</artifactId>
                    <version>${maven-asciidoctor-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.github.swagger2markup</groupId>
                    <artifactId>swagger2markup-maven-plugin</artifactId>
                    <version>${maven-swagger2markup-plugin.version}</version>
                </plugin>

                <!-- Javalin 专属：Spotify 镜像构建（ddd4j-parent 使用 io.fabric8） -->
                <plugin>
                    <groupId>com.spotify</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>${maven-spotify-docker-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.spotify</groupId>
                    <artifactId>dockerfile-maven-plugin</artifactId>
                    <version>${maven-dockerfile-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-guice-bridge</artifactId>
    <description>
        内联桥：ddd4j 2.0.x 的 Guice 运行时与核心契约子集（SpiKeys/I18nProvider/Contexts/
        CacheConfig/Readiness 等 + runtime-guice 核心装配类）。6.7.x 改挂 core 1.0.x 时，
        这些在 1.0.x（Spring AutoConfig 范式）中不存在，由本模块以原包名提供，
        javalin 各模块 import 零改动。来源：ddd4j 2.0.x ddd4j-runtime-guice / ddd4j-core。
        排除项（另行处理）：Ddd4jMybatis/Crypto/Logs 四个 data 向 Module（其中
        Mybatis/Crypto 已落位 ddd4j-javalin-data 对应模块）与 ddd4j-cache 构件。

        M3 追加：ddd4j 2.0.x web 契约内联（io.ddd4j.web.core 25 文件 +
        io.ddd4j.web.javalin 10 文件，Javalin 6 API 形态，原包名不变）。
        来源：ddd4j 2.0.x ddd4j-web-core / ddd4j-web-javalin。
        web-core 排除项：context.SynchronousWebRequestSession（消费闭包外）、
        idempotency.CacheIdempotencyGuard（依赖 ddd4j-cache.CacheKit，随 cache 内联另行处理）。

        M4 补充：core.cache 契约补全（CacheStats/CacheType/CasCache/CASOperation/AtomicCache/
        CacheLock/GetsResponse，支撑 ddd4j-javalin-cache 内联的 CacheKit/CaffeineCache）。
        其余去向：Ddd4jCacheGuiceModule → ddd4j-javalin-cache；Ddd4jMybatis/CryptoGuiceModule →
        ddd4j-javalin-data 对应模块；Ddd4jLogsGuiceModule 仍为排除项（另行处理）。
    </description>

    <dependencyManagement>
        <dependencies>
            <!-- 本模块直赖 javalin 6.7.0（显式钉版见下），jetty 必须同步 11.x；
                 直接条目优先于 parent 链/2.0.x BOM 的 12.1.8 管理（该版本不存在） -->
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-bom</artifactId>
                <version>11.0.25</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty.websocket</groupId>
                <artifactId>websocket-servlet</artifactId>
                <version>11.0.25</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-servlet</artifactId>
                <version>11.0.25</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-server</artifactId>
                <version>11.0.25</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-util</artifactId>
                <version>11.0.25</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.classgraph</groupId>
            <artifactId>classgraph</artifactId>
        </dependency>
        <!-- M3：web 契约（io.ddd4j.web.javalin）编译所需。
             显式钉 6.7.0：否则 ddd4j-core:2.0.x 传递的 2.0.x BOM（javalin 7.2.2）
             会赢得仲裁，造成 bridge 编译于 J7、运行于 J6 的混合解析 -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>6.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>

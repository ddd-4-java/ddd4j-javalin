<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-samples</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-javalin-sample-auth-satoken</artifactId>
    <description>ddd4j-javalin-auth + sa-token 集成示例：演示 SubjectKit 统一鉴权入口（Javalin + Guice）</description>

    <dependencies>
        <!-- ddd4j-javalin 注解（DDD 注解 + Web 路由参数注解） -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-annotation</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j-javalin Guice 扩展（含 DddAnnotationModule ClassGraph 扫描） -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-extension-guice</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- ddd4j-javalin auth sa-token 适配 -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-auth-satoken</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Javalin 6 -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
        </dependency>
    </dependencies>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-mq</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-javalin-mq-sqs</artifactId>
    <description>ddd4j-javalin MQ - sqs（无 Spring 强耦合，纯 Java SDK，Guice 桥接）。</description>
    <dependencies>
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-mq-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- M2 内联：2.0.x ddd4j-mq-sqs 契约已内联至 ddd4j-javalin-mq-sqs-contract（原包名 io.ddd4j.mq.*） -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-mq-sqs-contract</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ======== 测试：验证 Guice 装配 + 契约解析（用 mock AmazonSQS，无需真实 AWS）======== -->
        <!-- 真实 round-trip IT 依赖（版本由 ddd4j-dependencies BOM / awssdk-bom 管理） -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sqs</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-testcontainers</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
            <!-- 1.0.x 改挂补钉：assertj 原经 2.0.x 上游链传递，1.0.x 链不传递，显式声明（版本由 1.0.x ddd4j-dependencies 管理） -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

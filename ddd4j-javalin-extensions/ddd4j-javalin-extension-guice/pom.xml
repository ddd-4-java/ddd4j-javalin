            <artifactId>guice</artifactId>
        </dependency>
        <!-- ddd4j 核心模块（纯 Java，零框架依赖） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-core</artifactId>
        </dependency>
    </dependencies>

</project>

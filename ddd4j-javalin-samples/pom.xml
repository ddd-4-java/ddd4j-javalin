<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-parent</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-samples</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <!-- Auth 鉴权示例：演示 SubjectKit 统一鉴权入口（Javalin 编程式路由 + Guice）。
             原有的 sample-druid（io.javalin.sample 独立体系 + 不完整 JOOQ 生成代码 +
             引用已铲除的平行宇宙包）已移除，避免维护与 ddd4j 适配无关的腐烂示例。 -->
        <module>ddd4j-javalin-sample-auth-satoken</module>
        <module>ddd4j-javalin-sample-auth-security</module>
        <module>ddd4j-javalin-sample-auth-shiro</module>
        <!-- ddd4j 1.0.x 未发布对应上游 sample 构件，保留源码但不纳入本发布线 Reactor。 -->
        <!-- <module>ddd4j-javalin-sample-cqrs-person</module> -->
        <!-- <module>ddd4j-javalin-sample-rich-model</module> -->
        <module>ddd4j-javalin-sample-mybatis-testcontainers</module>
        <!-- ddd4j-sample-order-* 明确配置为不发布，跨仓库构建无法解析其父 POM。 -->
        <!-- <module>ddd4j-javalin-sample-order-outbox</module> -->
    </modules>

</project>

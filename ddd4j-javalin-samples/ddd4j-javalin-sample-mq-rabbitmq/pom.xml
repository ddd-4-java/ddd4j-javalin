<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-samples</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ddd4j-javalin-sample-mq-rabbitmq</artifactId>
    <description>ddd4j-javalin RabbitMQ (AMQP) 示例：业务发布 DomainEvent → RabbitMQ 投递 → @MQEventListener 消费</description>

    <dependencies>
        <!-- ddd4j 核心与注解 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-annotation</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!-- ddd4j Guice 运行时绑定 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-guice</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!-- ddd4j MQ 核心 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-mq-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!--
            ddd4j-mq-rabbitmq：基于 RabbitMQ (AMQP 0-9-1) 的消息队列实现。
            支持 Exchange / Queue / Binding 路由、消息确认、死信队列等企业级特性。
            需要运行中的 RabbitMQ Broker（参见 README.md）。
        -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-mq-rabbitmq</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>

        <!-- Javalin -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

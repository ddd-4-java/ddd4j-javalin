<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <relativePath>../ddd4j-javalin-dependencies</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-auth</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-javalin 认证授权整合聚合：license / satoken / security / shiro 与 Javalin + Guice 深度整合。
        底层复用 io.ddd4j:ddd4j-auth-* 纯 Java 实现，本层提供 Guice Module、Javalin ExceptionHandler。
    </description>

    <subprojects>
        <subproject>ddd4j-javalin-auth-core</subproject>
        <subproject>ddd4j-javalin-auth-oidc</subproject>
        <subproject>ddd4j-javalin-auth-license</subproject>
        <subproject>ddd4j-javalin-auth-satoken</subproject>
        <subproject>ddd4j-javalin-auth-security</subproject>
        <subproject>ddd4j-javalin-auth-shiro</subproject>
    </subprojects>

</project>

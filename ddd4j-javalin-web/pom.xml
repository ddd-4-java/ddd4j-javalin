<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-web</artifactId>
    <description>
        ddd4j-javalin Web 启动入口（对标 ddd4j-boot-web-webmvc / ddd4j-boot-web-webflux）：

        - Ddd4jJavalinProperties：ddd4j.web.javalin.* 配置 POJO
        - Ddd4jJavalinAutoConfiguration：Guice Module，装配 ddd4j-web-javalin 的 Ddd4jJavalinWeb
        - Ddd4jJavalinApplication：静态 run(...) 一键启动入口

        注：JavalinTestFixture 测试基类已迁移至 ddd4j-javalin-testcontainers 模块
        （io.ddd4j.javalin.testcontainers.web），本模块主代码不再依赖测试基础设施。

        所有 ddd4j-javalin sample 改为通过本模块启动，不再手工 Javalin.create()。
    </description>

    <dependencies>
        <!-- ddd4j Guice 适配 + web 适配（1.0.x 改挂：runtime-guice / web-javalin 均并入 bridge） -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-guice-bridge</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Javalin -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
        </dependency>
        <!-- Guice -->
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 1.0.x 改挂补钉：assertj 原经 2.0.x 上游链传递，1.0.x 链不传递，显式声明（版本由 1.0.x ddd4j-dependencies 管理） -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <!-- 跑单测 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-dependencies</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-mq</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j 消息队列在 Javalin 轨道的桥接聚合。
        参照 ddd4j-mq 多模块范式：
        - core（MQ 契约 + Guice 桥接）
        - disruptor / sqs / nats / ons / kafka / rocketmq / rabbitmq / activemq / pulsar / redis-stream / mqtt /
        mqtt-mica / tdmq（broker 桥接）
    </description>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-guice</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
    </dependencies>

    <modules>
        <module>ddd4j-javalin-mq-core</module>
        <module>ddd4j-javalin-mq-disruptor</module>
        <module>ddd4j-javalin-mq-sqs</module>
        <module>ddd4j-javalin-mq-nats</module>
        <module>ddd4j-javalin-mq-ons</module>
        <module>ddd4j-javalin-mq-kafka</module>
        <module>ddd4j-javalin-mq-rocketmq</module>
        <module>ddd4j-javalin-mq-rabbitmq</module>
        <module>ddd4j-javalin-mq-activemq</module>
        <module>ddd4j-javalin-mq-pulsar</module>
        <module>ddd4j-javalin-mq-redis-stream</module>
        <module>ddd4j-javalin-mq-mqtt</module>
        <module>ddd4j-javalin-mq-mqtt-mica</module>
        <module>ddd4j-javalin-mq-tdmq</module>
    </modules>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-bom</artifactId>
    <packaging>pom</packaging>
    <description>ddd4j-javalin module version BOM</description>

    <dependencyManagement>
        <dependencies>
            <!-- ddd4j 核心契约（纯 Java，零框架依赖） -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-core</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- ddd4j Guice 适配（提供 3 个核心 SPI 的 Guice 实现 Ddd4jGuiceModule） -->
            <dependency>
                <groupId>io.ddd4j</groupId>
                <artifactId>ddd4j-guice</artifactId>
                <version>${ddd4j.version}</version>
            </dependency>
            <!-- ddd4j-javalin 核心层（CQRS 视图管理 + Javalin Context Web 基类） -->
            <dependency>
                <groupId>io.ddd4j.javalin</groupId>
                <artifactId>ddd4j-javalin-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <!-- ddd4j-javalin Guice 集成（DDD 注解自动扫描绑定） -->
            <dependency>
                <groupId>io.ddd4j.javalin</groupId>
                <artifactId>ddd4j-javalin-guice</artifactId>
                <version>${revision}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>

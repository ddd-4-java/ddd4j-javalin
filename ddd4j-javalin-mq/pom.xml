<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 http://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <relativePath>../ddd4j-javalin-dependencies</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-mq</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j 消息队列在 Javalin 轨道的桥接聚合。
        参照 ddd4j-mq 多模块范式：
        - core（MQ 契约 + Guice 桥接）
        - disruptor / sqs / nats / ons / kafka / rocketmq / rabbitmq / activemq / pulsar / redis-stream / mqtt /
        mqtt-mica / tdmq（broker 桥接）
    </description>

    <dependencies>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-guice</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
    </dependencies>

    <subprojects>
        <subproject>ddd4j-javalin-mq-core</subproject>
        <subproject>ddd4j-javalin-mq-disruptor</subproject>
        <subproject>ddd4j-javalin-mq-sqs</subproject>
        <subproject>ddd4j-javalin-mq-nats</subproject>
        <subproject>ddd4j-javalin-mq-ons</subproject>
        <subproject>ddd4j-javalin-mq-kafka</subproject>
        <subproject>ddd4j-javalin-mq-rocketmq</subproject>
        <subproject>ddd4j-javalin-mq-rabbitmq</subproject>
        <subproject>ddd4j-javalin-mq-activemq</subproject>
        <subproject>ddd4j-javalin-mq-pulsar</subproject>
        <subproject>ddd4j-javalin-mq-redis-stream</subproject>
        <subproject>ddd4j-javalin-mq-mqtt</subproject>
        <subproject>ddd4j-javalin-mq-mqtt-mica</subproject>
        <subproject>ddd4j-javalin-mq-tdmq</subproject>
    </subprojects>

</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-data-logs</artifactId>
    <description>
        ddd4j-javalin 数据层 - API 操作日志整合：
        Guice Module 注册 ApiOperationLogProvider，通过 Javalin Handler 拦截请求记录日志。
    </description>

    <dependencies>
        <!-- ddd4j 数据层日志纯 AspectJ 实现 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-data-logs</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-guice-bridge</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Guice -->
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <!-- Javalin -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <scope>provided</scope>
        </dependency>
            <!-- 1.0.x 改挂补钉：assertj 原经 2.0.x 上游链传递，1.0.x 链不传递，显式声明（版本由 1.0.x ddd4j-dependencies 管理） -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
</dependencies>

</project>

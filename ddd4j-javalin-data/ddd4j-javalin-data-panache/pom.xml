<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-data</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-data-panache</artifactId>
    <description>
        ddd4j-javalin 数据层 - Panache ORM：
        多租户实体基类（TenantAwareEntity）、雪花 ID 生成器（SnowflakeIdGenerator）、查询构建辅助（RepositoryUtil）。
        复用 ddd4j-core 契约（Page 等），提供 Javalin + Guice 原生实现。
    </description>

    <dependencies>
        <!-- ddd4j 核心契约 -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-kit</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- 1.0.x 改挂：core.api（R/Page/IR）由 bridge 内联提供（1.0.x core 无该包） -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-guice-bridge</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- Guice DI -->
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <!-- Quarkus Panache ORM (runtime dependency for PanacheEntityBase) -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MicroProfile Config (for IdGeneratorProducer) -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- 单元测试：junit-jupiter / assertj-core 由 ddd4j-dependencies 继承链统一管理（test scope） -->
    </dependencies>

    <build>
        <plugins>
            <!-- 根 pom pluginManagement 全局 skip 单元测试；本模块含纯单元测试（无容器依赖），
                 参照 ddd4j-javalin-mq-* 模块方式本地开启。argLine 必须覆写：继承链中的
                 -XX:PermSize/-XX:MaxPermSize 在 JDK 17 下会导致 fork JVM 启动失败。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

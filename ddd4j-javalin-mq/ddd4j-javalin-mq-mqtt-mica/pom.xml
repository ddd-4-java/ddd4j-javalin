<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-mq</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>ddd4j-javalin-mq-mqtt-mica</artifactId>
    <description>
        ddd4j-javalin MQ - mqtt-mica：Guice 桥接 ddd4j-mq-mqtt-mica 的 BrokerAdapter 装配。
        业务方提供 mica-mqtt 的 MqttClientTemplate，Module 装配 ddd4j 组件。
    </description>
    <dependencies>
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-mq-core</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- M2 内联：2.0.x ddd4j-mq-mqtt-mica 契约已内联至 ddd4j-javalin-mq-mqtt-mica-contract（原包名 io.ddd4j.mq.*） -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-mq-mqtt-mica-contract</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- ======== 测试：验证 Guice 装配 + 契约解析（用 mock MqttClientTemplate，无需真实 MQTT）======== -->
        <!-- 真实 round-trip IT 依赖（版本由 ddd4j-dependencies BOM 管理） -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.dromara.mica-mqtt</groupId>
            <artifactId>mica-mqtt-client</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 1.0.x 改挂补钉：mica-mqtt 2.5.x 的 pom 错钉 mica-net-core 1.2.6（org.tio 包名），上游 ddd4j-mq-mqtt-mica:1.0.x 编译于 2.0.x（net.dreamlu.mica.net 包名），显式钉 2.0.13 -->
        <dependency>
            <groupId>net.dreamlu</groupId>
            <artifactId>mica-net-core</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
        <!-- 1.0.x 改挂补钉：mica-mqtt 2.5.10 运行时需要 org.tio（其 pom 错钉的 mica-net-core 1.2.6
             已被上面的 2.0.13 覆盖以提供 net.dreamlu.mica.net 包），由官方 t-io-core 3.8.6 补齐 org.tio 包 -->
        <dependency>
            <groupId>org.t-io</groupId>
            <artifactId>tio-core</artifactId>
            <version>3.8.6.v20240801-RELEASE</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-testcontainers</artifactId>
            <version>${revision}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

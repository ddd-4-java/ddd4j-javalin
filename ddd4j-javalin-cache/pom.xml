<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-dependencies</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-dependencies</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-cache</artifactId>
    <description>
        ddd4j-javalin 缓存层 Guice 桥接：通过 Guice Module 注册 CacheKit 到 Javalin + Guice 容器。
        内联 2.0.x ddd4j-cache 消费子集（io.ddd4j.cache.CacheKit / cache.local.CaffeineCache，原包名）
        与 Ddd4jCacheGuiceModule：6.7.x 改挂 core 1.0.x（无 ddd4j-cache 构件）时 import 零改动。
        排除项：cache.subject.InMemorySubject/InMemorySubjectProvider（1.0.x Subject 契约变更为
        M5 重写项）；CacheKit 的 GUAVA/HUTOOL 实现类（无消费方，未内联，枚举值保留）。
    </description>

    <dependencies>
        <!-- 内联 core.cache 契约（io.ddd4j.core.cache.*）与 Guice 运行时 -->
        <dependency>
            <groupId>io.ddd4j.javalin</groupId>
            <artifactId>ddd4j-javalin-guice-bridge</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 覆盖根 pom 的 skip=true，本模块运行集成测试 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <!-- 覆盖根 pom 的 Java8 argLine（-XX:PermSize 在 Java21 导致 forked VM 崩溃） -->
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

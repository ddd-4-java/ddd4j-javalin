<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         
         xsi:schemaLocation="http://maven.apache.org/POM/4.1.0 https://maven.apache.org/xsd/maven-4.1.0.xsd">
    <modelVersion>4.1.0</modelVersion>
    <parent>
        <relativePath>../ddd4j-javalin-dependencies/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-ddd</artifactId>
    <packaging>pom</packaging>
    <description>
        ddd4j-javalin DDD 基础设施入口：对齐 ddd4j-boot-ddd，复用 ddd4j-core、ddd4j-runtime-guice 与 fuinorg DDD/CQRS 轨道。
    </description>

    <dependencies>
        <!--
            ddd4j-dependencies 自 14082fde (fix(build): remove unreleased adapter dependencies)
            起不再管理 fuinorg DDD/CQRS 轨道版本，此处显式声明。
        -->
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-core</artifactId>
            <version>0.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-jackson</artifactId>
            <version>0.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.fuin.ddd4j</groupId>
            <artifactId>ddd-4-java-esc</artifactId>
            <version>0.7.0</version>
        </dependency>
        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-core</artifactId>
            <version>0.6.0</version>
        </dependency>
        <dependency>
            <groupId>org.fuin.cqrs4j</groupId>
            <artifactId>cqrs-4-java-jackson</artifactId>
            <version>0.6.0</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-core</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-guice</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.smallrye</groupId>
            <artifactId>jandex</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.fuin.esc</groupId>
            <artifactId>esc-mem</artifactId>
            <version>0.7.0</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>

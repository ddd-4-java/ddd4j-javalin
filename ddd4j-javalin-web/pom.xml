<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ddd4j.javalin</groupId>
        <artifactId>ddd4j-javalin-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../ddd4j-javalin-parent/pom.xml</relativePath>
    </parent>

    <artifactId>ddd4j-javalin-web</artifactId>
    <description>
        ddd4j-javalin Web 启动入口（对标 ddd4j-boot-web-webmvc / ddd4j-boot-web-webflux）：

        - Ddd4jJavalinProperties：ddd4j.web.javalin.* 配置 POJO
        - Ddd4jJavalinAutoConfiguration：Guice Module，装配 ddd4j-web-javalin6 的 Ddd4jJavalinWeb
        - Ddd4jJavalinApplication：静态 run(...) 一键启动入口
        - JavalinTestFixture：测试基类，app.start(0) + HttpClient round-trip

        所有 ddd4j-javalin sample 改为通过本模块启动，不再手工 Javalin.create()。
    </description>

    <dependencies>
        <!-- ddd4j web 适配（Javalin 6，applyTo 契约） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-web-javalin6</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- ddd4j runtime guice（提供 Ddd4jGuiceModule） -->
        <dependency>
            <groupId>io.ddd4j</groupId>
            <artifactId>ddd4j-runtime-guice</artifactId>
            <version>${ddd4j.version}</version>
        </dependency>
        <!-- Javalin -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
        </dependency>
        <!-- Guice -->
        <dependency>
            <groupId>com.google.inject</groupId>
            <artifactId>guice</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <!-- 跑单测 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <skipTests>false</skipTests>
                    <argLine>-Xmx1024m -Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>